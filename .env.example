# Server
PORT=3001
NODE_ENV=development
DATABASE_PATH=./data/payguard.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10

# Used only by `npm run db:seed` to hash demo-user passwords. Pick your own; never commit it.
DEMO_PASSWORD=

# Optional: real multimodal AI provider. Leave blank to use the deterministic demo fallback.
ANTHROPIC_API_KEY=
AI_MODEL=
